// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      // Launches the host without --inspect-brk. Use when the debugger fails to
      // attach and the Extension Development Host stays stuck on "reconnecting".
      "name": "Run Extension (no debug)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "noDebug": true,
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      // Same as "Run Extension" but writes a js-debug diagnostic log; its path
      // is printed in the Debug Console.
      "name": "Run Extension (trace)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "trace": true
    }
  ]
}
